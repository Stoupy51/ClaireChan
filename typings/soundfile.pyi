from collections.abc import Iterator
from io import BytesIO
from os import PathLike

import numpy as np

def read(file: str | PathLike[str] | BytesIO, dtype: str = "float64") -> tuple[np.ndarray[tuple[int], np.dtype[np.float32]], int]: ...

class _Info:
	duration: float

class SoundFile:
	def __init__(self, file: str | PathLike[str], mode: str, samplerate: int, channels: int) -> None: ...
	def __enter__(self) -> SoundFile: ...
	def __exit__(self, *args: object) -> None: ...
	def write(self, data: np.ndarray[tuple[int], np.dtype[np.float32]]) -> None: ...

def info(file: str | PathLike[str]) -> _Info: ...
def blocks(
	file: str | PathLike[str], blocksize: int, dtype: str = "float64", fill_value: float | None = None,
) -> Iterator[np.ndarray[tuple[int], np.dtype[np.float32]]]: ...
